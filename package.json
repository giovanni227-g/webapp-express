{
  "name": "webapp-express",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Express e Prisma per Alex & Maty Dashboard",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/routes/services.routes.js",
    "test": "node --env-file=.env --test --test-force-exit"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "supertest": "^7.3.2"
  }
}
